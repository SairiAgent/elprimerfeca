    "context": [
      {
        "ascii": "por que",
        "accented": "por qué",
        "pattern": "\\bpor que\\b",
        "why": "el interrogativo \"por qué\" lleva tilde y es tonico; la causal \"porque\" va junta y atona"
      },
      {
        "ascii": "para",
        "accented": "pará",
        "pattern": "(^|[.:;!?¿¡]\\s*)para\\s*[.,!?]",
        "why": "como frase suelta es el imperativo voseo \"pará\", no la preposicion \"para\""
      },
      {
        "ascii": "si",
        "accented": "sí",
        "pattern": "(^|[:;.]\\s*)si\\s*,",
        "why": "la afirmacion \"sí\" es tonica; la conjuncion condicional \"si\" es atona"
      },
      {
        "ascii": "mas",
        "accented": "más",
        "pattern": "\\bmas\\b",
        "why": "\"mas\" sin tilde es la conjuncion arcaica; en habla actual siempre es \"más\""
      },
      {
        "ascii": "esta",
        "accented": "está",
        "pattern": "\\besta\\s+(bajo|en|con|sin|de|para|[a-zñáéíóú]+(ando|endo|ado|ido|ada|ida))\\b",
        "why": "seguido de gerundio, participio o preposicion es el verbo \"está\""
      }
    ]
